# AUDITRA Environment Configuration Example
# Copy this file to .env and adjust as necessary for local development.

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Plant Default Settings
PLANT_ID=HELIOS-1
PLANT_NAME=Helios-1 Solar Park
PLANT_CAPACITY_MW=50.0
INVERTER_BLOCK_CAPACITY_MW=12.5
TELEMETRY_INTERVAL_MINUTES=15

# Timezone
TIMEZONE=UTC
